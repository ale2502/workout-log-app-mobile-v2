{
    "compilerOptions": {
      "target": "ES2020",
      "module": "ES2020",
      "moduleResolution": "Bundler",
      "rootDir": "server",
      "noEmit": true,
      "isolatedModules": true,
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "allowImportingTsExtensions": true,
      "allowJs": true,
      "skipLibCheck": true
    }
  }